# ==========================================
# FINN: FINANCIAL INVESTMENT AGENT CONFIG
# ==========================================

# Database
DATABASE_URL=sqlite+aiosqlite:///data/db/finn.db
SYNC_DATABASE_URL=sqlite:///data/db/finn.db

# AI filing reader. Easiest: add keys in the app under Settings, which saves them to backend/.env.
# LLM_PROVIDER is gemini, groq, openai or anthropic. Without a key, alerts work without AI headlines.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MIN_SECONDS_BETWEEN_CALLS=5

# Optional: send new alerts to your phone through a free Telegram bot. Also set in the app under Settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required to manage keys from anywhere but the machine running FINN, such as on a hosted deployment.
FINN_ADMIN_TOKEN=

# Mode Flags
DEMO_MODE=true
YAHOO_FINANCE_ENABLED=true

# Alert Engine Defaults
DEFAULT_PRICE_ALERT_THRESHOLD=3.0
DEFAULT_VOLUME_MULTIPLIER=2.0
DEFAULT_VOLUME_LOOKBACK=20
DEFAULT_DIGEST_HOURS=24

# Server Ports
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

