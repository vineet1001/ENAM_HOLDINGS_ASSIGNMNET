# ==========================================
# FINN: FINANCIAL INVESTMENT AGENT CONFIG
# ==========================================

# Database
DATABASE_URL=sqlite+aiosqlite:///data/db/finn.db
SYNC_DATABASE_URL=sqlite:///data/db/finn.db

# AI Provider Configuration (Optional - System operates deterministically without keys)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_STRONG_MODEL=gemini-2.5-pro

# Mode Flags
DEMO_MODE=true
YAHOO_FINANCE_ENABLED=true

# Alert Engine Defaults
DEFAULT_PRICE_ALERT_THRESHOLD=3.0
DEFAULT_VOLUME_MULTIPLIER=2.0
DEFAULT_VOLUME_LOOKBACK=20
DEFAULT_DIGEST_HOURS=24

# Server Ports
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
